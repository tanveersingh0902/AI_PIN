# ═══════════════════════════════════════════════════════════════
#  VIHAAN AI PIN — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Environment & Secrets ─────────────────────────────────────
.env
*.pem
*.key

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ──────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Data (keep structure, ignore contents) ────────────────────
data/logs/*.log
data/cache/*
data/models/*
!data/logs/.gitkeep
!data/cache/.gitkeep
!data/models/.gitkeep

# ── Testing ───────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
