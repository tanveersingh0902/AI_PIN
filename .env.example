# ═══════════════════════════════════════════════════════════════
#  VIHAAN AI PIN — Environment Variables
# ═══════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit your .env file to version control!
# ═══════════════════════════════════════════════════════════════

# ── General ───────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── Groq API (single key for STT + LLM) ──────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ── Speech-to-Text (Groq Whisper) ────────────────────────────
STT_MODEL=whisper-large-v3-turbo

# ── LLM (Groq) ───────────────────────────────────────────────
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7
# LLM_SYSTEM_PROMPT=Custom system prompt here (optional)

# ── Text-to-Speech (eSpeak NG — local executable) ────────────
ESPEAK_EXECUTABLE=espeak-ng
ESPEAK_VOICE=en
ESPEAK_SPEED=150

# ── Conversation ─────────────────────────────────────────────
CONVERSATION_MAX_TURNS=10

# ── Groq API settings ────────────────────────────────────────
GROQ_TIMEOUT=30

# ── Network connectivity and request retries ─────────────────
NETWORK_CONNECTION_TIMEOUT=15
CONNECTIVITY_CHECK_TIMEOUT=2
NETWORK_RETRY_COUNT=2
NETWORK_RETRY_DELAY=0.5

# ── Wake Word ─────────────────────────────────────────────────
WAKE_WORD=hey vihaan

# ── Audio ─────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024

# ── Hardware (Raspberry Pi GPIO pins) ─────────────────────────
BUTTON_GPIO_PIN=17
LED_GPIO_PIN=27
BATTERY_ADC_CHANNEL=0

# ── Resource Limits ───────────────────────────────────────────
MAX_MEMORY_MB=384
CACHE_MAX_ITEMS=50
