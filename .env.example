# ═══════════════════════════════════════════════════════════════
#  VIHAAN AI PIN — Environment Variables
# ═══════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit your .env file to version control!
# ═══════════════════════════════════════════════════════════════

# ── General ───────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── AI / LLM ─────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# ── Speech ────────────────────────────────────────────────────
STT_ENGINE=google
TTS_ENGINE=pyttsx3
WAKE_WORD=hey vihaan

# ── Audio ─────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024

# ── Network ───────────────────────────────────────────────────
WIFI_SSID=your-wifi-ssid
WIFI_PASSWORD=your-wifi-password
API_TIMEOUT=10

# ── Hardware (Raspberry Pi GPIO pins) ─────────────────────────
BUTTON_GPIO_PIN=17
LED_GPIO_PIN=27
BATTERY_ADC_CHANNEL=0

# ── Resource Limits ───────────────────────────────────────────
MAX_MEMORY_MB=384
CACHE_MAX_ITEMS=50
